{
  "name": "dashdb",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:db": "turbo run test:db",
    "e2e": "pnpm --filter @dashdb/web e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @dashdb/db db:generate",
    "db:migrate": "pnpm --filter @dashdb/db db:migrate",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --flag v10_config_lookup_from_file --no-warn-ignored --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,jsonc,md,css,yml,yaml,html,txt}": "prettier --write --ignore-unknown"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<3.4.17": "3.4.17"
    }
  }
}
