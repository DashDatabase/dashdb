# Secret scan first (fail fast), then format + lint the staged files.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is required but was not found on PATH." >&2
  echo "  Windows: winget install --id Gitleaks.Gitleaks -e" >&2
  echo "  macOS:   brew install gitleaks" >&2
  echo "  Linux:   https://github.com/gitleaks/gitleaks/releases" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --verbose --no-banner
pnpm exec lint-staged
