{
  "format": "dashdb.project",
  "version": 1,
  "exportedAt": "2026-10-31T16:40:43.069Z",
  "template": {
    "title": "Product analytics events",
    "description": "Event tracking for a product: projects, anonymous and known identities, sessions, raw events with JSON properties and daily rollups.",
    "tags": ["analytics", "events", "tracking", "time-series"],
    "dialect": "postgres",
    "tablesCount": 6,
    "decisions": [
      {
        "title": "Events are append-only with JSON properties",
        "body": "Each event is one immutable row with a name and a jsonb bag of properties. New event types need no migration, and the event_definitions catalog records which names exist so the UI can list them without scanning the events table."
      },
      {
        "title": "A BRIN index for time ranges",
        "body": "Events arrive roughly in time order, which is exactly what a BRIN index exploits: it is a tiny fraction of a B-tree's size, yet narrows \"last 7 days\" queries to the right blocks. A B-tree on (project_id, name, occurred_at) serves funnel queries for one event."
      },
      {
        "title": "Identities join anonymous and known users",
        "body": "Visitors start with an anonymous_id; signing in sets user_id on the same identity, so events from before sign-up stay attached to the person. The unique (project_id, anonymous_id) makes identify calls idempotent."
      },
      {
        "title": "Dashboards read rollups",
        "body": "daily_event_counts stores one row per project, day and event name, filled by a scheduled job. Charts read a few hundred rows instead of millions of events; raw events remain for ad-hoc questions."
      }
    ]
  },
