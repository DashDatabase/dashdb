{
  "format": "dashdb.project",
  "version": 1,
  "exportedAt": "2026-10-31T16:40:25.729Z",
  "template": {
    "title": "Food delivery",
    "description": "Restaurants with menus, customer orders with line items, couriers and deliveries tracked through their own status, for a delivery app.",
    "tags": ["delivery", "marketplace", "orders", "logistics"],
    "dialect": "postgres",
    "tablesCount": 8,
    "decisions": [
      {
        "title": "The order and the delivery have separate statuses",
        "body": "The kitchen moves an order from placed to ready; the courier moves the delivery from searching to delivered. Keeping them in two tables with two enums lets a courier be reassigned, or a delivery fail and be retried, without rewriting the order's history."
      },
      {
        "title": "Order lines keep the dish name and price",
        "body": "order_items copy the name and unit price when the order is placed, and only loosely reference the menu item (SET NULL on delete). Restaurants can edit or remove dishes without changing past receipts."
      },
      {
        "title": "Fees and tips are separate columns",
        "body": "Subtotal, delivery fee and tip are stored apart rather than as one total. Restaurants, couriers and the platform are each paid from different parts, and the receipt needs every line."
      },
      {
        "title": "Coordinates as plain numbers",
        "body": "Restaurants store latitude and longitude as numeric(9,6), enough for about 10 cm precision with no extension required. For radius searches at scale, switch the pair to a PostGIS geography column with a GiST index."
      }
    ]
  },
