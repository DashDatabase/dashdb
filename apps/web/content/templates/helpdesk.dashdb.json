{
  "format": "dashdb.project",
  "version": 1,
  "exportedAt": "2026-10-31T16:40:37.897Z",
  "template": {
    "title": "Helpdesk",
    "description": "Support tickets with statuses, priorities and SLA targets, team queues, public replies and internal notes, tags and satisfaction ratings.",
    "tags": ["support", "helpdesk", "tickets", "sla"],
    "dialect": "postgres",
    "tablesCount": 10,
    "decisions": [
      {
        "title": "Replies and internal notes share one table",
        "body": "Both are ticket_messages; is_internal marks the notes agents leave for each other. The conversation stays in one ordered stream for agents, while the customer view and email notifications filter internal notes out."
      },
      {
        "title": "SLA targets are keyed by priority",
        "body": "sla_policies has one row per priority, and tickets.priority references it. Response targets are data an admin can change, and every ticket is guaranteed to have one."
      },
      {
        "title": "Timestamps measure the SLA",
        "body": "first_responded_at and solved_at are set once, when they happen. Response and resolution times are then simple subtractions against the policy, with no event log to replay."
      },
      {
        "title": "One index serves every queue",
        "body": "Agents work queues like \"urgent open tickets for the billing team\". The composite index on (team_id, status, priority) answers all of them, in the order the filters are usually applied."
      }
    ]
  },
