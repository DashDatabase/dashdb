{
  "format": "dashdb.project",
  "version": 1,
  "exportedAt": "2026-10-31T16:40:31.975Z",
  "template": {
    "title": "Inventory and warehousing",
    "description": "Warehouses with bin locations, products, suppliers, purchase orders, a stock movement ledger and current stock levels per bin.",
    "tags": ["inventory", "warehouse", "supply-chain", "ledger"],
    "dialect": "postgres",
    "tablesCount": 8,
    "decisions": [
      {
        "title": "A movement ledger is the source of truth",
        "body": "Every change in stock is an append-only row in stock_movements: positive for receipts and returns, negative for shipments. Audits, \"what did we have on March 1st\" and shrinkage reports all come from summing the ledger."
      },
      {
        "title": "Stock levels are a fast cache of the ledger",
        "body": "stock_levels holds on_hand and reserved per product and bin, updated in the same transaction as each movement. Pickers and checkout read one row instead of summing history, and the ledger can rebuild it if it ever drifts."
      },
      {
        "title": "Reservations cannot exceed stock",
        "body": "A CHECK keeps reserved at or below on_hand, so the database itself refuses to promise more units than are on the shelf, even if two orders race."
      },
      {
        "title": "Purchase order lines track partial receipts",
        "body": "Each line keeps quantity_ordered and quantity_received, and unit cost with four decimal places for accurate landed costs. Receiving a partial delivery updates the line and writes receipt movements that point back to the purchase order."
      }
    ]
  },
