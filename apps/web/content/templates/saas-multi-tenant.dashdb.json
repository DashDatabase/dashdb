{
  "format": "dashdb.project",
  "version": 1,
  "exportedAt": "2026-10-31T16:36:58.610Z",
  "template": {
    "title": "SaaS multi-tenant",
    "description": "Organizations, users with roles, invitations, plans, subscriptions, invoices, API keys and an audit log: the core of a B2B SaaS app.",
    "tags": ["saas", "multi-tenant", "billing", "auth"],
    "dialect": "postgres",
    "tablesCount": 9,
    "decisions": [
      {
        "title": "Memberships instead of users.organization_id",
        "body": "People often belong to more than one workspace, so users and organizations meet in a memberships table with a composite primary key and a role. Removing someone from a team deletes a row; it never touches the user."
      },
      {
        "title": "Every tenant-owned row carries organization_id",
        "body": "Invitations, subscriptions, API keys and audit events all reference the organization directly, with an index starting on organization_id. Queries are scoped with one equality, and the schema is ready for PostgreSQL row-level security policies if you add them."
      },
      {
        "title": "Secrets are stored as hashes",
        "body": "API keys and invitation tokens keep only a hash (bytea) plus a short visible prefix for API keys. A database leak exposes nothing usable, and the prefix still lets people recognise their keys in the UI."
      },
      {
        "title": "Billing history is kept, not overwritten",
        "body": "A subscription row records the plan and period, and invoices hang off subscriptions. Changing plans adds history instead of editing the organization, which keeps invoices consistent with what was sold at the time."
      }
    ]
  },
