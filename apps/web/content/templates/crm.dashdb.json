{
  "format": "dashdb.project",
  "version": 1,
  "exportedAt": "2026-10-31T16:40:09.062Z",
  "template": {
    "title": "CRM",
    "description": "Companies, contacts, deals moving through configurable pipelines, and calls, emails and meetings logged against them.",
    "tags": ["crm", "sales", "pipeline", "b2b"],
    "dialect": "postgres",
    "tablesCount": 7,
    "decisions": [
      {
        "title": "Pipeline stages are rows, not an enum",
        "body": "Every sales team names its stages differently and reorders them. Stages live in pipeline_stages with a position and a win probability, so teams edit them in the app and the forecast uses each stage's probability without a schema change."
      },
      {
        "title": "Deleting a person does not delete history",
        "body": "Owners and contacts are referenced with ON DELETE SET NULL wherever a record should outlive them: a departed sales rep's deals stay, unassigned, and so do companies. Only a contact's own activity log is removed with the contact."
      },
      {
        "title": "Amounts keep their currency",
        "body": "Deals store amount as numeric(14,2) together with a three-letter currency code. Summing pipelines across currencies is then a deliberate conversion step instead of a silent mistake."
      },
      {
        "title": "Activities point at the contact, the deal is optional",
        "body": "A call happens with a person; it may or may not be about a deal. Requiring contact_id and allowing deal_id avoids a polymorphic \"subject\" column, which would lose foreign keys."
      }
    ]
  },
