{
  "format": "dashdb.project",
  "version": 1,
  "exportedAt": "2026-10-31T16:37:05.227Z",
  "template": {
    "title": "E-commerce store",
    "description": "Products with variants, nested categories, carts, orders with line items, addresses and payments, for a MySQL-backed online shop.",
    "tags": ["e-commerce", "orders", "payments", "catalog"],
    "dialect": "mysql",
    "tablesCount": 10,
    "decisions": [
      {
        "title": "Variants carry price, SKU and stock",
        "body": "A product is what customers browse; a variant (size, color) is what they buy. Price, SKU and stock live on product_variants, so a T-shirt in three sizes is one product and three sellable rows, with the options kept as JSON."
      },
      {
        "title": "Orders copy what they need",
        "body": "order_items store the product name and unit price, and orders store the shipping address, at the moment of purchase. Later price changes or an edited address book never rewrite what a customer was charged or where the parcel went."
      },
      {
        "title": "Payments are separate from orders",
        "body": "One order can see several payment attempts (a decline, then a success, then a refund). Each is a row with the provider's reference, unique per provider, so webhook retries cannot record the same payment twice."
      },
      {
        "title": "Money is DECIMAL, never FLOAT",
        "body": "Prices and totals use decimal(10,2) and decimal(12,2). Floating point cannot represent most cent amounts exactly, and rounding errors in totals are the kind of bug that shows up in accounting months later."
      }
    ]
  },
