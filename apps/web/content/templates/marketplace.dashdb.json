{
  "format": "dashdb.project",
  "version": 1,
  "exportedAt": "2026-10-31T16:37:11.340Z",
  "template": {
    "title": "Two-sided marketplace",
    "description": "Buyers and sellers in one user table, listings with images, orders with platform fees, reviews, seller payouts and disputes.",
    "tags": ["marketplace", "e-commerce", "payments", "reviews"],
    "dialect": "postgres",
    "tablesCount": 8,
    "decisions": [
      {
        "title": "One user table, an optional seller profile",
        "body": "Everyone signs up as a user; selling adds a one-to-one seller_profiles row keyed by user_id. Buyers who never sell carry no empty seller columns, and seller-only data such as the payout account and commission rate has a clear home."
      },
      {
        "title": "The platform fee is recorded per order",
        "body": "orders store both the price and the platform_fee_cents taken at checkout. Commission rates change over time, and payouts and accounting need the fee that applied to that sale, not today's rate."
      },
      {
        "title": "One review per order",
        "body": "reviews.order_id is unique, so only buyers who completed a purchase can review, and only once. Ratings are checked to be between 1 and 5 by the database, not just the form."
      },
      {
        "title": "Payouts group earnings by period",
        "body": "Sellers are paid in batches, so payouts cover a date range per seller rather than mirroring individual orders. That matches how payment providers transfer money and keeps reconciliation to one row per transfer."
      }
    ]
  },
