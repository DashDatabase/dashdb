{
  "format": "dashdb.project",
  "version": 1,
  "exportedAt": "2026-10-31T16:40:14.568Z",
  "template": {
    "title": "Booking system",
    "description": "Appointments for salons, clinics or studios: staff, services, weekly availability, time off and bookings across locations, in MySQL.",
    "tags": ["booking", "scheduling", "appointments", "services"],
    "dialect": "mysql",
    "tablesCount": 8,
    "decisions": [
      {
        "title": "Availability is rules, not pre-made slots",
        "body": "Staff hours are stored as weekly rules (weekday, start and end time, optional date range) plus time-off periods. Free slots are computed on request, so changing a service's length or someone's hours never requires regenerating thousands of slot rows."
      },
      {
        "title": "Bookings copy the price",
        "body": "A booking stores the price it was made at, which may come from the service or a staff member's custom price. Later price changes leave existing appointments alone."
      },
      {
        "title": "Double booking is blocked at the start time",
        "body": "A unique key on (staff_id, starts_at) stops two bookings starting together. MySQL has no exclusion constraints, so fully overlapping ranges must be checked in the same transaction that inserts the booking, with SELECT … FOR UPDATE on the staff member's bookings for that day."
      },
      {
        "title": "Each location has its own time zone",
        "body": "Times are stored as local datetimes with the location's IANA time zone beside them. Opening hours stay correct across daylight-saving changes, which a fixed UTC offset would get wrong twice a year."
      }
    ]
  },
