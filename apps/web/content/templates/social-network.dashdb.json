{
  "format": "dashdb.project",
  "version": 1,
  "exportedAt": "2026-10-31T16:40:20.269Z",
  "template": {
    "title": "Social network",
    "description": "Users and profiles, follows, posts with replies and media, likes, notifications and blocks: the tables behind a timeline app.",
    "tags": ["social", "feed", "notifications", "community"],
    "dialect": "postgres",
    "tablesCount": 8,
    "decisions": [
      {
        "title": "Follows are a self-referencing join table",
        "body": "follows links users to users with a composite primary key, so nobody can follow the same account twice, and a CHECK stops users following themselves. A second index on following_id makes \"who follows me\" as fast as \"who do I follow\"."
      },
      {
        "title": "No stored like or follower counts",
        "body": "Counts are derived with indexed COUNT queries instead of counter columns, which drift out of sync under concurrent writes. When a hot account needs it, add a cached counter later; the source of truth stays the rows."
      },
      {
        "title": "Unread notifications have their own index",
        "body": "The notification badge only asks for unread rows. A partial index WHERE read_at IS NULL keeps that query quick, however many old notifications a user has accumulated."
      },
      {
        "title": "Replies are posts",
        "body": "A reply is a post with reply_to_id set, so threads, quoting and media work the same everywhere. If the original is deleted, replies stay and simply lose their parent."
      }
    ]
  },
