{
  "format": "dashdb.project",
  "version": 1,
  "exportedAt": "2026-10-31T16:39:57.007Z",
  "template": {
    "title": "Blog and CMS",
    "description": "Posts with publishing states and revision history, categories, tags, threaded comments with moderation, and a media library.",
    "tags": ["blog", "cms", "content", "publishing"],
    "dialect": "postgres",
    "tablesCount": 9,
    "decisions": [
      {
        "title": "The body lives in revisions",
        "body": "posts hold what changes rarely (slug, title, status); every saved body is a new post_revisions row. The latest revision is the current text, and editors can compare or restore any earlier version without an extra history system."
      },
      {
        "title": "A partial index for the public site",
        "body": "Readers only ever see published posts, ordered by date. The index on published_at includes only rows WHERE status = 'published', so it stays small and fast even when drafts and archives outnumber live posts."
      },
      {
        "title": "Threaded comments with one parent column",
        "body": "comments.parent_id points at another comment, so replies nest to any depth, and deleting a comment removes its replies with it. New comments start unapproved, keeping moderation in the database rather than only in the UI."
      },
      {
        "title": "Categories and tags are both join tables",
        "body": "A post can sit in several categories and carry many tags. Two small join tables with composite primary keys prevent duplicates and make both filters a single join."
      }
    ]
  },
