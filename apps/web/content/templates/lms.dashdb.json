{
  "format": "dashdb.project",
  "version": 1,
  "exportedAt": "2026-10-31T16:40:03.166Z",
  "template": {
    "title": "Learning platform (LMS)",
    "description": "Courses split into sections and lessons, enrollments, per-lesson progress, quizzes with scored attempts, and verifiable certificates.",
    "tags": ["education", "lms", "courses", "progress"],
    "dialect": "postgres",
    "tablesCount": 9,
    "decisions": [
      {
        "title": "Order is a position column, unique per parent",
        "body": "Sections and lessons carry an integer position, unique within their course or section. The database rejects two lessons in the same slot, and reordering is a handful of updates rather than a linked list to repair."
      },
      {
        "title": "Progress hangs off the enrollment",
        "body": "lesson_progress is keyed by (enrollment_id, lesson_id), not by user. If someone takes a course twice, or is refunded and re-enrolls, each run has its own progress, and deleting an enrollment cleans up after itself."
      },
      {
        "title": "Every quiz attempt is kept",
        "body": "Attempts are rows with their score and answers rather than a single best score on the enrollment. Instructors see how many tries a question takes, and the pass mark lives on the quiz so it can change for future attempts."
      },
      {
        "title": "Certificates use random ids",
        "body": "A certificate's id is a uuid, which is safe to print in a public verification link: it cannot be guessed by counting, unlike the sequential ids used elsewhere."
      }
    ]
  },
