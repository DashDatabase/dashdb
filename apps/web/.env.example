# Copy to .env.local and adjust. Everything here is optional; see README.md.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Public site: canonical/OG origin and the GitHub repository for the star button.
# NEXT_PUBLIC_SITE_URL=https://dashdb.dev
# NEXT_PUBLIC_GITHUB_URL=https://github.com/DashDatabase/dashdb
# GITHUB_TOKEN=

# Waitlist storage: Postgres (run `pnpm db:migrate` first), a Resend audience, or both.
# DATABASE_URL=postgres://dashdb:dashdb@localhost:5432/dashdb
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=
