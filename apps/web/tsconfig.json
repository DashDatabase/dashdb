{
  "extends": "@dashdb/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "collections/*": ["./.source/*"],
      "@dashdb/active-edition": ["./src/edition/oss.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "e2e",
    "test",
    "scripts/**/*.ts",
    "*.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
