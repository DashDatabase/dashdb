{
  "extends": "@dashdb/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "e2e",
    "scripts/**/*.ts",
    "*.config.ts",
