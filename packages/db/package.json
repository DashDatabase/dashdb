{
  "name": "@dashdb/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --clean",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@dashdb/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@dashdb/config": "workspace:*",
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
