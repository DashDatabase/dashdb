{
  "name": "@dashdb/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --clean",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dashdb/shared": "workspace:*",
    "@dbml/core": "10.3.1",
    "@mrleebo/prisma-ast": "0.16.0",
    "nanoid": "^5.1.16",
    "node-sql-parser": "5.4.0",
    "pgsql-ast-parser": "12.0.2",
    "prettier": "^3.9.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dashdb/config": "workspace:*",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.39.5",
    "prisma": "7.10.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
