{
  "name": "@dashdb/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "default": "./dist/lite.js"
    },
    "./parsers": {
      "types": "./dist/parsers.d.ts",
      "default": "./dist/parsers.js"
    },
    "./serializers": {
      "types": "./dist/serializers.d.ts",
      "default": "./dist/serializers.js"
    },
    "./convert": {
      "types": "./dist/convert.d.ts",
      "default": "./dist/convert.js"
    },
    "./examples": {
      "types": "./dist/examples.d.ts",
      "default": "./dist/examples.js"
    }
  },
  "scripts": {
    "build": "tsup --clean",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dashdb/shared": "workspace:*",
    "@dbml/core": "10.3.1",
    "@mrleebo/prisma-ast": "0.16.0",
    "nanoid": "^5.1.16",
    "node-sql-parser": "5.4.0",
    "pgsql-ast-parser": "12.0.2",
    "prettier": "^3.9.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dashdb/config": "workspace:*",
    "@testcontainers/mysql": "^12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "mysql2": "3.24.6",
    "postgres": "^3.4.9",
    "prisma": "7.10.1",
    "testcontainers": "^12.2.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
